{
  "expo": {
    "name": "NeuroFocus",
    "slug": "neurofocus-front",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "neurofocusfront",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/neurofocus/icono_neurofocus_vb.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#3B7A70",
        "foregroundImage": "./assets/neurofocus/foco_neurofocus_verde-512x512.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/neurofocus/icono_neurofocus_vb.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
