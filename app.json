{
  "expo": {
    "name": "NeuroFocus",
    "slug": "neurofocus-front",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/neurofocus/icono_neurofocus_vb.png",
    "scheme": "neurofocusfront",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/neurofocus/icono_neurofocus_vb.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundImage": "./assets/neurofocus/bg_foco_blanco.png",
        "foregroundImage": "./assets/neurofocus/foco_neurofocus_verde-512x512.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.kostasense.neurofocusfront"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/neurofocus/icono_neurofocus_vb.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#3B7A70",
          "image": "./assets/neurofocus/icono_neurofocus_vb.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-build-properties",
        { "android": { "usesCleartextTraffic": true } }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-build-properties"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7aa8a9bb-477e-43c3-b17e-8a15bf8d8a5f"
      }
    }
  }
}
